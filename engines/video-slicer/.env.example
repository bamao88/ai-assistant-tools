# video-slicer LLM config (used by `plan --mode query|auto` and bilingual subtitles).
#
# This tool reads a `.env` from its root directory on startup. On the assistant_zh
# box, the real `.env` is a SYMLINK to the shared credential file so MiniMax/Kimi
# keys live in exactly one place:
#
#   ln -sf /Volumes/ExtSSD2601/AI_Assistant/assistant_zh/knowledge_base/.env .env
#
# Override the path with VIDEO_SLICER_ENV_FILE=/abs/path/to/.env if needed.
#
# Provider selection mirrors the knowledge_ingest pipeline (same key names):
LLM_PROVIDER=minimax          # primary: minimax | kimi | openai (default minimax)
LLM_FALLBACK=kimi             # tried if the primary's keys fail (default kimi)

# MiniMax (OpenAI-compatible)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7

# Kimi (OpenAI-compatible, coding endpoint)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-for-coding

# Plain OpenAI / any OpenAI-compatible endpoint (last-resort fallback)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# VIDEO_SLICER_MODEL=gpt-4o-mini
