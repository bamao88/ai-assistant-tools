      "label": "普通文章封面",
      "base_image": "covers/article-cover-base.png",
      "source_filename": "23.png",
      "usage": "长方形区域用于公众号推荐页封面标题；正方形区域用于私聊/聊天场景封面关键词展示。",
      "input_rules": {
        "title": {
          "required": true,
          "processing": [
            "优先按冒号、破折号、竖线等标题分隔符切成上下两段。",
            "每段目标不超过 10 个中文等效字符；英文词不拆字母，按整词保留。",
            "第二段允许做轻度语义压缩，例如“那一层到底在干什么”可压成“那层在干嘛”。",
            "如果用户明确提供 title_primary/title_secondary，优先使用用户提供值。"
          ]
        },
        "keywords": {
          "required": false,
          "processing": [
            "正方形区域展示 2 个关键词。",
            "每个关键词只能是单个英文词，或不超过 3 个中文字符。",
            "优先提取标题里的英文专名；第二关键词优先取 AI/产品/技术名词，如模型、智能体、提示词、框架、工具等。",
            "如果用户明确提供 keyword_top/keyword_bottom，优先使用用户提供值。"
          ]
        }
      },
