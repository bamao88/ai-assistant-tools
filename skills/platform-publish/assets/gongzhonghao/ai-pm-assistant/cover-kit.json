      "base_image": "covers/article-cover-base.png",
      "cover_type": "article",
      "description": "AI PM 小助理普通文章封面。左侧长方形用于公众号推荐页，右侧正方形用于私聊/转发卡片。",
      "usage": "长方形区域用于公众号推荐页封面标题；正方形区域用于私聊/聊天场景封面关键词展示。",
      "crop_presets": {
        "pic_crop_235_1": "0_0_0.701481_1",
        "pic_crop_1_1": "0.701481_0_1_1"
      },
      "fields": {
        "title": "原始文章标题。脚本会拆成 title_primary/title_secondary，并从中提取 keyword_top/keyword_bottom。",
        "title_primary": "左侧长方形上方标题段；通常由 title 自动拆分，目标不超过 10 个中文等效字符。",
        "title_secondary": "左侧长方形下方标题段；通常由 title 自动拆分，目标不超过 10 个中文等效字符，可做轻度语义压缩。",
        "keyword_top": "右侧正方形上方关键词；单个英文词，或不超过 3 个中文字符。",
        "keyword_bottom": "右侧正方形下方关键词；单个英文词，或不超过 3 个中文字符。"
      },
      "input_rules": {
        "title": {
          "required": true,
          "processing": [
            "优先按冒号、破折号、竖线等标题分隔符切成上下两段。",
            "每段目标不超过 10 个中文等效字符；英文词不拆字母，按整词保留。",
            "第二段允许做轻度语义压缩，例如“那一层到底在干什么”可压成“那层在干嘛”。",
            "如果用户明确提供 title_primary/title_secondary，优先使用用户提供值。"
          ]
        },
        "keywords": {
          "required": false,
          "processing": [
            "正方形区域展示 2 个关键词。",
            "每个关键词只能是单个英文词，或不超过 3 个中文字符。",
            "优先提取标题里的英文专名；第二关键词优先取 AI/产品/技术名词，如模型、智能体、提示词、框架、工具等。",
            "如果用户明确提供 keyword_top/keyword_bottom，优先使用用户提供值。"
          ]
        }
      },
